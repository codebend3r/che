_che_flag_complete() {
  local cmd="$1" cur="${words[CURRENT]}"

  if [[ "$cur" == *=* ]]; then
    compset -P '*='
    _files
    return
  fi

  local -a flags
  flags=( ${=$(_che_flags_for "$cmd")} )
  compadd -S '' -- $flags
  _files
}

