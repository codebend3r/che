#!/usr/bin/env python3
"""Runs `bun run ci`, the check sanity-check.yml runs on main.

Enable for this clone with:
  git config core.hooksPath hooks
"""

from __future__ import annotations

import os
import shutil
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "bin"))

from utils import run, run_output


def main() -> int:
    os.chdir(run_output(["git", "rev-parse", "--show-toplevel"]))
    if shutil.which("bun") is None:
        print(
            "pre-push: bun not installed (`brew install bun`). Bypass with `git push --no-verify`."
        )
        return 1
    return run(["bun", "run", "ci"], check=False).returncode


if __name__ == "__main__":
    sys.exit(main())
